# Local development — copy to packages/db/.env and apps/api/.env (never commit secrets)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
API_PORT=4000
HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=ChangeMe123!

# ---------------------------------------------------------------------------
# Railway (API service) — set these in the Railway dashboard Variables tab
# ---------------------------------------------------------------------------
# NODE_ENV=production
# PORT is injected by Railway automatically (do not set API_PORT in prod)
# DATABASE_URL=<Railway Postgres variable / reference>
# JWT_SECRET=<long random string>
# JWT_EXPIRES_IN=7d
# CORS_ORIGIN=https://your-app.vercel.app,http://localhost:3000
# UPLOAD_DIR=/tmp/uploads
# HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Vercel (Web / apps/web) — Project → Settings → Environment Variables
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
#
# After the Vercel URL is known, update Railway CORS_ORIGIN to include it
# (and any preview URLs you need, comma-separated).
